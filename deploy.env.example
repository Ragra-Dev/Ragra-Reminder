# Copy to `.env` on the server (`cp deploy.env.example .env`) and fill it in.
# `.env` is git-ignored: never commit it.

# Your public hostname, no scheme and no slash, e.g. ragra-reminder.duckdns.org
RAGRA_DOMAIN=

RAGRA_TICK_INTERVAL_SECONDS=120
RAGRA_TIMEZONE=Asia/Karachi
RAGRA_WEB_BASE_URL=https://<RAGRA_DOMAIN>
RAGRA_OAUTH_REDIRECT_URI=https://<RAGRA_DOMAIN>/auth/callback
RAGRA_OAUTH_CLIENT_ID=
RAGRA_OAUTH_CLIENT_SECRET=
# python -m ragra.cli generate-credential-key  (keep a copy elsewhere)
RAGRA_CREDENTIAL_KEY=
RAGRA_OWNER_EMAIL=
RAGRA_OPEN_SIGNUP=1
RAGRA_MAX_USERS=100

# Email reminders (Gmail app password)
RAGRA_SMTP_HOST=smtp.gmail.com
RAGRA_SMTP_PORT=587
RAGRA_SMTP_USERNAME=
RAGRA_SMTP_PASSWORD=
RAGRA_EMAIL_FROM=
