# Copy to .env and adjust. Never commit the real .env.

# Where Ragra stores its own data (SQLite DB, its own Calendar credential).
# Defaults to <LOCAL_APPDATA>\ragra if unset.
RAGRA_HOME=

# FAST student ID, used for timetable lookup. Optional.
FAST_STUDENT_ID=

# Google OAuth client registration, shared by the Classroom and Calendar
# adapters. Defaults to <LOCAL_APPDATA>\hermes\google\credentials.json (an
# existing file location, not a dependency on anything else). Only set this
# if it lives somewhere different.
RAGRA_GOOGLE_OAUTH_CLIENT_FILE=

# Where Ragra's Classroom token is stored. Defaults to the same directory
# as RAGRA_GOOGLE_OAUTH_CLIENT_FILE above.
RAGRA_GOOGLE_CLASSROOM_TOKEN_DIR=

# Where Ragra stores its own Calendar-only credential (calendar.events
# scope, separate from the Classroom token). Defaults to a file under
# RAGRA_HOME.
RAGRA_GOOGLE_CALENDAR_CREDENTIAL_FILE=

RAGRA_CALENDAR_ID=primary

RAGRA_WEB_HOST=127.0.0.1
RAGRA_WEB_PORT=8731

# FAST timetable spreadsheet - publicly readable, no credential needed for
# values. This key is optional and only enables reliable tab discovery via
# the Sheets API; without it, tabs are found by name-matching instead. Get
# a free, read-only key from the same Google Cloud project (APIs & Services
# > Credentials), restricted to the Sheets API. Never commit the real value.
RAGRA_SHEETS_API_KEY=your_google_sheets_api_key_here
# The spreadsheet ID (from its URL). Not a secret - it's a public sheet.
RAGRA_FAST_TIMETABLE_SPREADSHEET_ID=1vlTuotLw34fedME3gNQj09cZw-todVomxAiu5P1wZ6Q

# Campus timezone, as an IANA name (never a fixed UTC offset). Timetable
# times are campus wall-clock values; this is what turns them into real
# instants, and what "today" means everywhere in the UI. Defaults to
# Asia/Karachi. Missing timezone data is a hard error rather than a silent
# fallback - see ragra/tz.py.
RAGRA_TIMEZONE=Asia/Karachi

# Notification providers - all optional. Ragra runs fine with none
# configured; due reminders just stay pending until one is set. Core Ragra
# (ragra/reminders/dispatch.py, ragra/health.py) never knows which provider
# it's talking to - only send(notification) (see ragra/adapters/notify.py's
# NotificationProvider protocol).

# Hermes: an optional, advanced-personal-integration provider for
# installations that already run Hermes (e.g. for WhatsApp delivery) - not
# required by Ragra core, and not needed unless you already have Hermes set
# up. Never commit real values for these.
HERMES_BIN=
RAGRA_NOTIFY_TARGET=

# Email: an optional provider using plain SMTP (standard library only, no
# extra dependency). Since Phase 3 the SERVER settings below are per
# deployment, while the RECIPIENT is per account - stored in the database
# and set with `ragra notify-set --email you@example.com`. That split is
# deliberate: a globally configured recipient would be how one user's
# reminders end up delivered to another user. RAGRA_EMAIL_TO and
# RAGRA_NOTIFY_TARGET below are now only used by `ragra notify-adopt-env`,
# the one-time migration that moves an existing single-user setup's
# destinations onto that account.
# The password is read from the environment and is never written into an
# error message, a log line, or the delivery-status table - but it is still
# a real credential, so never commit the actual value.
RAGRA_SMTP_HOST=
RAGRA_SMTP_PORT=587
RAGRA_SMTP_USERNAME=
RAGRA_SMTP_PASSWORD=
# Set to 1/true to use implicit TLS (usually port 465) instead of STARTTLS.
RAGRA_SMTP_USE_SSL=
RAGRA_EMAIL_FROM=
RAGRA_EMAIL_TO=

# Optional dashboard link appended to notification emails, e.g.
# http://127.0.0.1:8731 - purely a convenience, nothing depends on it.
RAGRA_WEB_BASE_URL=


# ---------------------------------------------------------------------------
# Identity and sign-in (Phase 3)
# ---------------------------------------------------------------------------

# Google sign-in. Ragra identifies a user by the Google subject id in the
# verified ID token, never by email address - an account's email can change
# while its subject id cannot. Sign-in is CLOSED BY DEFAULT: with none of
# this configured, nobody can sign in.
#
# Leaving these unset keeps the existing single-user behaviour, but ONLY for
# requests from this machine and ONLY while the database holds exactly one
# never-signed-in account. Any other shape - a second account, or a request
# from the network - requires real sign-in. Never commit real values.
RAGRA_OAUTH_CLIENT_ID=
RAGRA_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client, e.g.
# http://127.0.0.1:8731/auth/callback
RAGRA_OAUTH_REDIRECT_URI=

# The one account permitted to claim the pre-identity owner row - the row
# every record created before Phase 3 belongs to. Email is used for this
# single bootstrap decision and nothing else; from then on identity is the
# Google subject id. Without this, that history cannot be claimed by anyone.
RAGRA_OWNER_EMAIL=

# Additional accounts permitted to sign in, comma-separated. Each gets its
# own empty account. Leave blank to allow only the owner.
RAGRA_ALLOWED_EMAILS=

# Force the Secure flag on session cookies. Derived automatically from
# RAGRA_OAUTH_REDIRECT_URI's scheme, so this is only needed behind a
# TLS-terminating proxy where the redirect URI is legitimately http. It can
# be forced on, never off for an https deployment.
RAGRA_SECURE_COOKIES=

# Encryption key for stored Google credentials. Generate with:
#     ragra generate-credential-key
# Keep it somewhere OTHER than alongside the database - a key stored next to
# the file it encrypts protects nothing. Without it, credentials cannot be
# stored or read; Ragra fails closed rather than falling back to plaintext.
# Losing it means every Google authorization must be granted again.
RAGRA_CREDENTIAL_KEY=
