# Copy to .env and adjust. Never commit the real .env.

# Path to the local Hermes Agent checkout. Ragra imports the read-only
# hermes_cli.classroom.{oauth,google_client} modules directly from here.
HERMES_REPO_PATH=C:\Users\Hashim Amjad\AppData\Local\hermes\hermes-agent

# Path to hermes.exe (or the `hermes` launcher), used only via subprocess for
# `hermes send --to <target> "message"`. Never imported directly.
HERMES_BIN=C:\Users\Hashim Amjad\AppData\Local\hermes\hermes-agent\bin\hermes.exe

# Where Ragra stores its own data (SQLite DB, its own Calendar credential).
# Defaults to %LOCALAPPDATA%\ragra if unset.
RAGRA_HOME=

# Messaging target passed to `hermes send --to <target>`. Leave blank to
# disable notifications (sync/reminders still run, just don't send).
RAGRA_NOTIFY_TARGET=

# FAST student ID, used for timetable lookup (P1). Optional for P0.
FAST_STUDENT_ID=

# Google OAuth client registration (same installed-app client Hermes'
# Classroom integration already uses). Only override if it lives somewhere
# other than %LOCALAPPDATA%\hermes\google\credentials.json.
RAGRA_GOOGLE_OAUTH_CLIENT_FILE=

# Where Ragra stores its OWN Calendar-only credential (calendar.events
# scope, separate from Hermes' Classroom credential). Defaults to a file
# under RAGRA_HOME.
RAGRA_GOOGLE_CALENDAR_CREDENTIAL_FILE=

RAGRA_CALENDAR_ID=primary

RAGRA_WEB_HOST=127.0.0.1
RAGRA_WEB_PORT=8731

# FAST timetable source (P1). The spreadsheet itself is publicly readable
# (confirmed: no OAuth needed), but the Sheets API still requires some
# credential on every call, even for public data - a plain, free, read-only
# API key satisfies that without any login/consent flow. Create one in the
# same Google Cloud project already used for Classroom/Calendar (APIs &
# Services > Credentials > Create Credentials > API key), then restrict it
# to the Sheets API only. Never commit the real value.
RAGRA_SHEETS_API_KEY=

# The FAST timetable spreadsheet ID (from its URL). Not a secret - it's a
# public sheet - but kept configurable since the university could change it.
RAGRA_FAST_TIMETABLE_SPREADSHEET_ID=1vlTuotLw34fedME3gNQj09cZw-todVomxAiu5P1wZ6Q
