# Copy to .env and adjust. Never commit the real .env.

# Path to the local Hermes Agent checkout. Ragra imports the read-only
# hermes_cli.classroom.{oauth,google_client} modules directly from here -
# this is a real, required dependency for Classroom sync specifically (not
# for FAST timetable sync, which never touches Hermes at all). Leave blank
# to use the portable default Ragra already resolves on its own:
# %LOCALAPPDATA%\hermes\hermes-agent (i.e. under whichever account runs it -
# never hardcode a specific username here). Only set this if Hermes lives
# somewhere else.
HERMES_REPO_PATH=

# Path to hermes.exe (or the `hermes` launcher), used only via subprocess for
# `hermes send --to <target> "message"`. Never imported directly. Optional -
# only needed for notification delivery; leave blank to use the portable
# default (HERMES_REPO_PATH/bin/hermes.exe).
HERMES_BIN=

# Where Ragra stores its own data (SQLite DB, its own Calendar credential).
# Defaults to %LOCALAPPDATA%\ragra if unset.
RAGRA_HOME=

# Messaging target passed to `hermes send --to <target>`. Leave blank to
# disable notifications (sync/reminders still run, just don't send).
RAGRA_NOTIFY_TARGET=

# FAST student ID, used for timetable lookup (P1). Optional for P0.
FAST_STUDENT_ID=

# Google OAuth client registration (same installed-app client Hermes'
# Classroom integration already uses). Only override if it lives somewhere
# other than %LOCALAPPDATA%\hermes\google\credentials.json.
RAGRA_GOOGLE_OAUTH_CLIENT_FILE=

# Where Ragra stores its OWN Calendar-only credential (calendar.events
# scope, separate from Hermes' Classroom credential). Defaults to a file
# under RAGRA_HOME.
RAGRA_GOOGLE_CALENDAR_CREDENTIAL_FILE=

RAGRA_CALENDAR_ID=primary

RAGRA_WEB_HOST=127.0.0.1
RAGRA_WEB_PORT=8731

# FAST timetable source (P1). The spreadsheet is genuinely public - values
# are always read through the public gviz endpoint with NO credential of
# any kind, confirmed live. This key is OPTIONAL and only enables true
# tab-title enumeration (Sheets API metadata); without it, weekday tabs are
# discovered by trying each weekday's canonical name against the same
# public endpoint (also confirmed live) - less robust to an unexpected
# future rename, but needs zero setup. If you want the more robust
# enumeration, create a free, read-only key in the same Google Cloud
# project already used for Classroom/Calendar (APIs & Services >
# Credentials > Create Credentials > API key), restricted to the Sheets
# API only. Never commit the real value.
RAGRA_SHEETS_API_KEY=your_google_sheets_api_key_here
# The FAST timetable spreadsheet ID (from its URL). Not a secret - it's a
# public sheet - but kept configurable since the university could change it.
RAGRA_FAST_TIMETABLE_SPREADSHEET_ID=1vlTuotLw34fedME3gNQj09cZw-todVomxAiu5P1wZ6Q

# Optional, remote-capable notification path (ragra/adapters/telegram_notify.py):
# a direct HTTPS call to Telegram's Bot API, with no dependency on Hermes,
# its gateway, or any local executable - the only delivery path that can
# work from a remote/cloud worker as things stand today. Leave both blank
# to keep using the existing Hermes-based path (RAGRA_NOTIFY_TARGET/
# HERMES_BIN above) locally; this is additive, not a replacement.
# Create a bot token via @BotFather. RAGRA_TELEGRAM_CHAT_ID must be the
# numeric chat id the Bot API itself resolves for your account - do not
# assume it's the same value Hermes has cached for its own internal use;
# confirm it independently (e.g. message your bot, then check
# api.telegram.org/bot<token>/getUpdates).
RAGRA_TELEGRAM_BOT_TOKEN=
RAGRA_TELEGRAM_CHAT_ID=
