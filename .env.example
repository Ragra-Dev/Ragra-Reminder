# Copy to .env and adjust. Never commit the real .env.

# Where Ragra stores its own data (SQLite DB, its own Calendar credential).
# Defaults to %LOCALAPPDATA%\ragra if unset.
RAGRA_HOME=

# FAST student ID, used for timetable lookup. Optional.
FAST_STUDENT_ID=

# Google OAuth client registration, shared by the Classroom and Calendar
# adapters. Defaults to %LOCALAPPDATA%\hermes\google\credentials.json (an
# existing file location, not a dependency on anything else). Only set this
# if it lives somewhere different.
RAGRA_GOOGLE_OAUTH_CLIENT_FILE=

# Where Ragra's Classroom token is stored. Defaults to the same directory
# as RAGRA_GOOGLE_OAUTH_CLIENT_FILE above.
RAGRA_GOOGLE_CLASSROOM_TOKEN_DIR=

# Where Ragra stores its own Calendar-only credential (calendar.events
# scope, separate from the Classroom token). Defaults to a file under
# RAGRA_HOME.
RAGRA_GOOGLE_CALENDAR_CREDENTIAL_FILE=

RAGRA_CALENDAR_ID=primary

RAGRA_WEB_HOST=127.0.0.1
RAGRA_WEB_PORT=8731

# FAST timetable spreadsheet - publicly readable, no credential needed for
# values. This key is optional and only enables reliable tab discovery via
# the Sheets API; without it, tabs are found by name-matching instead. Get
# a free, read-only key from the same Google Cloud project (APIs & Services
# > Credentials), restricted to the Sheets API. Never commit the real value.
RAGRA_SHEETS_API_KEY=your_google_sheets_api_key_here
# The spreadsheet ID (from its URL). Not a secret - it's a public sheet.
RAGRA_FAST_TIMETABLE_SPREADSHEET_ID=1vlTuotLw34fedME3gNQj09cZw-todVomxAiu5P1wZ6Q

# Notification providers - all optional. Ragra runs fine with none
# configured; due reminders just stay pending until one is set. Core Ragra
# (ragra/reminders/dispatch.py, ragra/health.py) never knows which provider
# it's talking to - only send(message) (see ragra/adapters/notify.py's
# NotificationProvider protocol).

# Hermes: an optional, advanced-personal-integration provider for
# installations that already run Hermes (e.g. for WhatsApp delivery) - not
# required by Ragra core, and not needed unless you already have Hermes set
# up. Never commit real values for these.
HERMES_BIN=
RAGRA_NOTIFY_TARGET=
